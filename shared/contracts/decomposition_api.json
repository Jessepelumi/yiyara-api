{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yiyara Decomposition Inter-Service API Contract",
  "description": "API payload contracts shared between services/api (Django) and services/decomposer (Go)",
  "definitions": {
    "DecompositionTriggerRequest": {
      "type": "object",
      "required": ["goal_id", "user_id", "raw_input"],
      "properties": {
        "goal_id": { "type": "string", "format": "uuid" },
        "user_id": { "type": "string" },
        "raw_input": { "type": "string", "minLength": 1 },
        "due_date": { "type": ["string", "null"], "format": "date" }
      }
    },
    "TaskIngestionItem": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "estimated_duration_minutes": { "type": "integer", "default": 30 },
        "order": { "type": "integer", "default": 0 },
        "parent_index": { "type": ["integer", "null"] }
      }
    },
    "BulkTaskIngestionPayload": {
      "type": "object",
      "required": ["tasks"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/definitions/TaskIngestionItem" }
        }
      }
    }
  }
}
